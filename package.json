{
  "name": "cpp-coverage-tool",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.3 || ^24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
