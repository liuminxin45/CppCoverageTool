    "test:package": "node scripts/verify-package.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "chatgpt-desktop-kit": "git+https://github.com/liuminxin45/ChatGPT-Desktop-UI.git#b5ea2bd312e9e9c007b84859d550314ddae4acb5",
