    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "github:liuminxin45/ChatGPT-Desktop-UI#b5ea2bd312e9e9c007b84859d550314ddae4acb5": true,
    "esbuild@0.28.2": true
  }
}
